# Copernicus Data Space Ecosystem
CDSE_USERNAME=
CDSE_PASSWORD=

CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vyom

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# Storage: Wasabi S3
STORAGE_BACKEND=s3
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

S3_ENDPOINT_URL=https://s3.ap-southeast-1.wasabisys.com
S3_ACCESS_KEY=REPLACE_WITH_WASABI_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_WASABI_SECRET_KEY
S3_BUCKET_RAW=vyom-raw
S3_BUCKET_PROCESSED=vyom-processed
S3_REGION=ap-southeast-1
S3_USE_SSL=true

# Discovery defaults
DEFAULT_MAX_CLOUD_COVER=40
S2_COLLECTION=SENTINEL-2
S2_PRODUCT_TYPE=S2MSI2A
S1_COLLECTION=SENTINEL-1
S1_PRODUCT_TYPE=IW_GRDH_1S

# Beta login gate
# AUTH_SECRET_KEY: generate a real random value, e.g. `openssl rand -hex 32`
AUTH_SECRET_KEY=change-this-to-a-long-random-string
AUTH_SESSION_TTL_HOURS=24
AUTH_USERS=admin:changeme,agridoot:changeme2
ERROR_PANEL_USERNAMES=admin

# Google Sign-In: create an OAuth Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials -- add both this server's
# domain AND your local dev origin to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID

# AgriDoot's own phone-OTP SMS API
AGRIDOOT_OTP_URL=https://apiv2.agridoot.co.in:12443/ad/v2/user/genotp
AGRIDOOT_OTP_API_KEY=REPLACE_WITH_REAL_KEY
